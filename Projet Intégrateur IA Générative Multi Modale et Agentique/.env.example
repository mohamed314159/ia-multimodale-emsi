# Copier ce fichier en .env (le .env n'est jamais publié sur GitHub)

# Modèle de chat : azure (par défaut) ou ollama
LLM_PROVIDER=azure

# Azure OpenAI (même configuration que l'AP5)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Ollama (seulement si LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
VISION_MODEL=qwen2.5vl:3b

# PostgreSQL + PGVector (voir docker-compose.yml)
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=maintidoc

# Embeddings texte (Hugging Face, open source, calculés en local)
TEXT_EMBED_MODEL=intfloat/multilingual-e5-small
TEXT_EMBED_DIM=384
